@model IEnumerable<Front.Models.Respuestas.UsuarioFront>

@{
    ViewData["Title"] = "GetUsuarios";
}

<div class="container mt-4">
    <!-- buscador, filtro y botones de crear y modificar -->
    <div class="d-flex justify-content-between mb-3">
      <div class="d-flex align-items-center">
        <input type="text" id="searchBox" class="form-control me-2" placeholder="Buscar..." style="width: 250px; height: 48px;">

        <div class="dropdown me-2">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="btnFiltro" data-bs-toggle="dropdown" aria-expanded="false" style="height:32px; padding:2px 10px;">
                <i class="bi bi-funnel"></i> Filtro
            </button>
            <ul class="dropdown-menu p-3" aria-labelledby="btnFiltro" style="min-width: 200px;">
                <li>
                    <label>Filtrar por rol:</label>
                    <select id="filtroRol" class="form-select mb-2">
                        <option value="">Todos los roles</option>
                        @foreach (var rol in Model.Select(u => u.RolUsuarioDescripcion).Distinct())
                        {
                            <option value="@rol">@rol</option>
                        }
                    </select>
                </li>
                <li>
                    <label>Ordenar por nombre:</label>
                    <select id="ordenNombre" class="form-select">
                        <option value="">Sin orden</option>
                        <option value="asc">Ascendente</option>
                        <option value="desc">Descendente</option>
                    </select>
                </li>
            </ul>
        </div>
      </div>
        <div>
            <a asp-controller="Usuario" asp-action="CreateUsuario" class="btn btn-secondary">Crear usuario</a>
        </div>
    </div>

    <!-- tabla de usuarios-->
    <table class="tablas" id="tablaUsuarios">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.RolUsuarioDescripcion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)                
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DNI)
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.RolUsuarioDescripcion</td>
                    <td>@usuario.Nombre @usuario.Apellido</td>
                    <td>@usuario.DNI</td>
                    <td class="acciones">

                        <!-- Botón informacion -->
                        <button type="button"
                                class="btn btn-sm btn-info"
                                data-bs-toggle="modal"
                                data-bs-target="#informacionUsuario"
                                data-dni="@usuario.DNI"
                                data-nombre="@usuario.Nombre"
                                data-apellido="@usuario.Apellido"
                                data-localidad="@usuario.Localidad"
                                data-direccion="@usuario.Direccion"
                                data-telefono="@usuario.CaracteristicaTelefono @usuario.NumeroTelefono"
                                data-rol="@usuario.RolUsuarioDescripcion"
                                data-fechaContratoIngreso="@usuario.FechaContratoIngreso.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">
                            <i class="bi bi-info-circle"></i>
                        </button>

                        <!-- Botón borrar -->
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal"
                                data-dni="@usuario.DNI"
                                data-nombre="@usuario.Nombre"
                                data-apellido="@usuario.Apellido">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
       </table>
</div>

<!-- ELIMINAR -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteLabel">Eliminar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage">¿Desea eliminar al usuario seleccionado?</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="" id="confirmCheckbox">
                    <label class="form-check-label" for="confirmCheckbox">
                        Confirmar
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" id="btnAceptar" disabled>Aceptar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<!-- INFORMACION -->
<!-- INFORMACION -->
<div class="modal fade" id="informacionUsuario" tabindex="-1" aria-labelledby="infoUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="infoUsuarioForm" method="post" asp-action="UpdateUsuario" asp-controller="Usuario">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="infoUsuarioLabel">Información del Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="infoDni" class="form-label">Usuario (DNI):</label>
                            <input type="text" id="infoDni" name="dni" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoNombre" class="form-label">Nombre:</label>
                            <input type="text" id="infoNombre" name="Nombre" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoApellido" class="form-label">Apellido:</label>
                            <input type="text" id="infoApellido" name="Apellido" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoLocalidad" class="form-label">Localidad:</label>
                            <input type="text" id="infoLocalidad" name="Localidad" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoDireccion" class="form-label">Dirección:</label>
                            <input type="text" id="infoDireccion" name="Direccion" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoCaracteristicaTelefono" class="form-label">Característica Teléfono:</label>
                            <input type="text" id="infoCaracteristicaTelefono" name="CaracteristicaTelefono" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoNumeroTelefono" class="form-label">Número Teléfono:</label>
                            <input type="text" id="infoNumeroTelefono" name="NumeroTelefono" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="infoRol" class="form-label">Rol:</label>
                            <input type="text" id="infoRol" class="form-control" disabled />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnModificar" class="btn btn-secondary">Modificar</button>
                    <button type="submit" id="btnConfirmar" class="btn btn-primary">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>



<script src="~/js/usuarios.js"></script>