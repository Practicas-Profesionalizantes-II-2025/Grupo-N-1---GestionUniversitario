@model IEnumerable<Front.Models.Respuestas.ExamenFront>

@{
    ViewData["Title"] = "Exámenes";
}

<!-- Barra superior con buscador y botones -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="max-width: 300px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="searchBox" class="form-control" placeholder="Buscar...">

        <div class="dropdown ms-2">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="btnFiltroExamen" data-bs-toggle="dropdown" aria-expanded="false" style="height:38px; padding:2px 10px;">
                <i class="bi bi-funnel"></i> Filtro
            </button>
            <ul class="dropdown-menu p-3" aria-labelledby="btnFiltroExamen" style="min-width: 220px;">
                <li class="form-check">
                    <input class="form-check-input" type="checkbox" value="Final" id="chkFinal">
                    <label class="form-check-label" for="chkFinal">Final</label>
                </li>
                <li class="form-check">
                    <input class="form-check-input" type="checkbox" value="Parcial" id="chkParcial">
                    <label class="form-check-label" for="chkParcial">Parcial</label>
                </li>
            </ul>
        </div>
    </div>

    <div>
        <a asp-controller="Examen" asp-action="CreateExamen" class="btn btn-secondary">Crear</a>
    </div>
</div>

<!-- Tabla de exámenes -->
<table class="table table-striped table-bordered align-middle" id="tablaExamenes">
    <thead class="table-secondary">
        <tr>
            <th class="text-center">@Html.DisplayNameFor(model => model.Tipo)</th>
            <th class="text-center">@Html.DisplayNameFor(model => model.NombreMateria)</th>
            <th class="text-center">@Html.DisplayNameFor(model => model.Fecha)</th>
            <th class="text-center">@Html.DisplayNameFor(model => model.DescripcionDiaHorario)</th>
            <th class="text-center" style="width:100px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var examen in Model)
        {
            <tr>
                <td>@examen.Tipo</td>
                <td>@examen.NombreMateria</td>
                <td>@examen.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@examen.DescripcionDiaHorario.Split(' ')[1] @examen.DescripcionDiaHorario.Split(' ')[2] @examen.DescripcionDiaHorario.Split(' ')[3]</td>
                <td class="text-center acciones">
                    <!-- Botón información -->
                    <button type="button" class="btn btn-sm btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#informacionExamen"
                            data-id="@examen.ID"
                            data-tipo="@examen.Tipo"
                            data-materia="@examen.NombreMateria"
                            data-horario="@examen.DescripcionDiaHorario.Split(' ')[1] @examen.DescripcionDiaHorario.Split(' ')[2] @examen.DescripcionDiaHorario.Split(' ')[3]"
                            data-fecha="@examen.Fecha.ToString("yyyy-MM-dd")">
                        <i class="bi bi-info-circle"></i>
                    </button>
                    <!-- Botón eliminar -->
                    <button type="button" class="btn btn-sm btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#confirmDeleteModal"
                            data-id="@examen.ID"
                            data-tipoExamen="@examen.Tipo"
                            data-nombreMateria="@examen.NombreMateria"
                            data-descripcionDiaHorario="@examen.DescripcionDiaHorario"
                            data-fecha="@examen.Fecha.ToString("dd/MM/yyyy")">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar Examen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage">¿Desea eliminar el examen seleccionado?</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirmCheckbox">
                    <label class="form-check-label" for="confirmCheckbox">Confirmar</label>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" id="btnAceptar" disabled>Eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de información examen -->
<div class="modal fade" id="informacionExamen" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="infoExamenForm" asp-action="UpdateExamen" asp-controller="Examen" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Información del Examen</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <input type="hidden" id="infoID" name="ID" />

                <div class="modal-body">
                    <!-- Tipo -->
                    <div class="mb-3">
                        <label class="form-label">Tipo *</label>
                        <select name="Tipo" id="infoTipo" class="form-select" disabled>
                            <option value="">Seleccione...</option>
                            <option value="Final">Final</option>
                            <option value="Parcial">Parcial</option>
                        </select>
                    </div>

                    <!-- Materia -->
                    <div class="mb-3">
                        <label class="form-label">Materia *</label>
                        <select name="NombreMateria" id="infoMateria" asp-items="ViewBag.Materias" class="form-select" disabled>
                            <option value="">Seleccione...</option>
                        </select>
                    </div>

                    <!-- Horario -->
                    <div class="mb-3">
                        <label class="form-label">Horario *</label>
                        <select name="DescripcionDiaHorario" id="infoHorario" asp-items="ViewBag.Horarios" class="form-select" disabled>
                            <option value="">Seleccione...</option>
                        </select>
                    </div>

                    <!-- Fecha -->
                    <div class="mb-3">
                        <label class="form-label">Fecha *</label>
                        <input name="Fecha" id="infoFecha" type="date" class="form-control" disabled />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnModificarExamen" class="btn btn-secondary">Modificar</button>
                    <button type="submit" class="btn btn-primary" id="btnConfirmarExamen" disabled>Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CARGAR NOTAS -->
<div class="modal fade" id="cargarNotasModal" tabindex="-1" aria-labelledby="cargarNotasLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <form id="cargarNotasForm" method="post" asp-controller="NotaAlumno" asp-action="CrearNotaAlumno">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="cargarNotasLabel">
                        <i class="bi bi-pencil-square me-2"></i> Cargar Notas
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="notaExamenId" name="IDExamen" />

                    <!-- Tabla de alumnos -->
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Alumno</th>
                                    <th>DNI</th>
                                    <th>Nota</th>
                                </tr>
                            </thead>
                            <tbody id="tablaAlumnosNotas">
                                <!-- Se rellena dinámicamente con los inscriptos -->
                                <tr>
                                    <td>Juan Pérez</td>
                                    <td>12345678</td>
                                    <td>
                                        <input type="number" class="form-control nota-input" name="Notas[0].Nota" min="0" max="100" required />
                                        <input type="hidden" name="Notas[0].DNIAlumno" value="12345678" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>María López</td>
                                    <td>87654321</td>
                                    <td>
                                        <input type="number" class="form-control nota-input" name="Notas[1].Nota" min="0" max="100" required />
                                        <input type="hidden" name="Notas[1].DNIAlumno" value="87654321" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i> Guardar Notas
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/examenes.js?v=@DateTime.Now.Ticks"></script>
