@model Front.Models.Crear.CrearExamenFront

@{
    ViewData["Title"] = "CreteExamen";
}

<h2 class="text-center py-2 bg-secondary text-white rounded">Nuevo Examen</h2>
<hr />

<form asp-action="CreateExamen">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="NombreMateria" class="form-label">Materia *</label>
                <select asp-for="NombreMateria" asp-items="ViewBag.Materias" class="form-select required-field">
                    <option value="">Seleccione...</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Tipo" class="form-label">Tipo *</label>
                <select asp-for="Tipo" class="form-select required-field">
                    <option value="">Seleccione...</option>
                    <option value ="Parcial">Parcial</option>
                    <option value="Final">Final</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="DescripcionDiaHorario" class="form-label">Horario *</label>
                <select asp-for="DescripcionDiaHorario" asp-items="ViewBag.Horario" class="form-select required-field">
                    <option value="">Seleccione...</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="DescripcionDiaHorario" class="form-label">Fecha *</label>
                <input asp-for="DescripcionDiaHorario" class="form-control" type="date" />
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div class="d-flex justify-content-end mt-3">
        <input type="submit" value="Aceptar" class="btn btn-secondary me-2" />
        <a asp-action="GetExamenes" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
<script src="~/js/examenes.js"></script>