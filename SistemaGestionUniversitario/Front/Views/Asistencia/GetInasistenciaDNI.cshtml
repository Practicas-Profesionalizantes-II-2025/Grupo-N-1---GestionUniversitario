@model IEnumerable<Front.Models.Respuestas.AsistenciaFront>

@{
    ViewData["Title"] = "GetInasistenciaDNI";

    // Agrupo por materia, solo inasistencias
    var materiasAgrupadas = Model
        .Where(a => !a.Estado)
        .GroupBy(a => a.NombreMateria)
        .ToList();
}

<h2>Inasistencias</h2>

@if (!materiasAgrupadas.Any())
{
    <div class="alert alert-success">No tenés inasistencias registradas 🎉</div>
}
else
{
    <div class="accordion" id="accordionMaterias">
        @for (int i = 0; i < materiasAgrupadas.Count; i++)
        {
            var materia = materiasAgrupadas[i];
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@i">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse-@i"
                            aria-expanded="false"
                            aria-controls="collapse-@i">
                        @materia.Key  <!-- NombreMateria -->
                    </button>
                </h2>
                <div id="collapse-@i" class="accordion-collapse collapse"
                     aria-labelledby="heading-@i" data-bs-parent="#accordionMaterias">
                    <div class="accordion-body">
                        <ul class="list-group">
                            @foreach (var inasistencia in materia)
                            {
                                <li class="list-group-item">
                                    📅 @inasistencia.Fecha.ToString("dd/MM/yyyy")
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
}