@model IEnumerable<Front.Models.Respuestas.AsistenciaFront>

@{
    ViewData["Title"] = "Registro Asistencias";
    List<Front.Models.Respuestas.MateriaFront>? materias = ViewBag.Materias as List<Front.Models.Respuestas.MateriaFront>;
    string? selectedMateria = ViewBag.SelectedMateria as string;
}

<div class="container">
    <h3>Registro de Asistencias</h3>

    @if (!materias.Any())
    {
        <div class="alert alert-warning">⚠️ No tenés ninguna materia vinculada.</div>
    }
    else
    {
        <!-- Selección de Materia -->
        <form asp-action="GetAsistenciasMateria" method="get" class="mb-3">
            <select name="nombreMateria" class="form-select w-auto d-inline-block" onchange="this.form.submit()">
                <option value="">Seleccione una Materia</option>
                @if (materias != null)
                {
                    foreach (var materia in materias)
                    {
                        <option value="@materia.Nombre"
                                selected="@(selectedMateria == materia.Nombre ? "selected" : null)">
                            @materia.Nombre
                        </option>
                    }
                }
            </select>
        </form>

        @if (!string.IsNullOrEmpty(selectedMateria))
        {
            if (!Model.Any())
            {
                <div class="alert alert-info">
                    No hay asistencias registradas para esta materia.
                </div>
            }
            else
            {
                <div class="accordion" id="accordionAsistencias">
                    @foreach (var grupo in Model.GroupBy(a => a.Fecha.Date))
                    {
                        var fechaId = grupo.Key.ToString("yyyyMMdd");
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@fechaId">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse-@fechaId"
                                        aria-expanded="false"
                                        aria-controls="collapse-@fechaId">
                                    📅 @grupo.Key.ToString("dd/MM/yyyy")
                                </button>
                            </h2>
                            <div id="collapse-@fechaId" class="accordion-collapse collapse"
                                 aria-labelledby="heading-@fechaId" data-bs-parent="#accordionAsistencias">
                                <div class="accordion-body">

                                    <!-- Form principal de modificación -->
                                    <form asp-action="ModAsistencia" asp-controller="Asistencia" method="post" id="form-modificar-@fechaId">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="nombreMateria" value="@selectedMateria" />

                                        @for (int i = 0; i < grupo.Count(); i++)
                                        {
                                            var asistencia = grupo.ElementAt(i);
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       name="asistencias[@i].Estado"
                                                       value="true"
                                                @(asistencia.Estado ? "checked" : "") />
                                                <input type="hidden" name="asistencias[@i].IdInscripcion" value="@asistencia.IdInscripcion" />
                                                <input type="hidden" name="asistencias[@i].NombreMateria" value="@asistencia.NombreMateria" />
                                                <input type="hidden" name="asistencias[@i].Fecha" value="@asistencia.Fecha.ToString("yyyy-MM-dd")" />
                                                <label class="form-check-label">@asistencia.NombreAlumno @asistencia.ApellidoAlumno</label>
                                            </div>
                                        }
                                    </form>

                                    <!-- fila de botones (fuera del form principal) -->
                                    <div class="mt-3 d-flex justify-content-between align-items-center">
                                        <!-- botón que abre el modal -->
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar-@fechaId">
                                            Eliminar
                                        </button>

                                        <!-- botones del form principal -->
                                        <div>
                                            <button type="submit" class="btn btn-secondary me-2" form="form-modificar-@fechaId">Modificar</button>
                                            <button type="reset" class="btn btn-secondary" form="form-modificar-@fechaId">Cancelar</button>
                                        </div>
                                    </div>

                                    <!-- modal de confirmación -->
                                    <div class="modal fade" id="modalEliminar-@fechaId" tabindex="-1" aria-labelledby="modalLabel-@fechaId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modalLabel-@fechaId">Confirmar eliminación</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                </div>
                                                <div class="modal-body">
                                                    ¿Seguro que querés eliminar la asistencia del <strong>@grupo.Key.ToString("dd/MM/yyyy")</strong>?
                                                    <br>
                                                    Esta acción no se puede deshacer.
                                                </div>
                                                <div class="modal-footer">
                                                    <!-- formulario real de eliminación -->
                                                    <form asp-action="DeleteAsistencia" asp-controller="Asistencia" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="nombreMateria" value="@selectedMateria" />
                                                        <input type="hidden" name="fecha" value="@grupo.Key.ToString("yyyy-MM-dd")" />
                                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                                    </form>

                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>


                        </div>
                    }
                </div>
            }
        }
    }
</div>

<script src="~/js/asistencias.js"></script>