@{
    ViewData["Title"] = "Historia Académica";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white text-center py-3">
            <h3 class="mb-0">Historia Académica del Alumno</h3>
        </div>

        <div class="card-body">
            <div id="alert-container"></div>

            <div class="table-responsive">
                <table id="tablaNotas" class="table table-striped table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>Materia</th>
                            <th>Tipo de Examen</th>
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody id="tablaNotasBody">
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                Cargando notas...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const tablaBody = document.getElementById("tablaNotasBody");
            const alertContainer = document.getElementById("alert-container");

            try {
                const response = await fetch(`/Nota/ObtenerNotasPorAlumno`);
				console.log(response);
                if (!response.ok) {
                    throw new Error("Error al obtener las notas del alumno.");
                }

                const notas = await response.json();

                tablaBody.innerHTML = ""; // limpiar contenido anterior

                if (notas.length === 0) {
                    mostrarAlerta("No se encontraron notas registradas para este alumno.", "info");
                    return;
                }

                // Ordenar por materia y tipo
                notas.sort((a, b) => {
                    if (a.examenMateriaNombre === b.examenMateriaNombre)
                        return a.examenTipo.localeCompare(b.examenTipo);
                    return a.examenMateriaNombre.localeCompare(b.examenMateriaNombre);
                });

                notas.forEach(nota => {
                    const fila = document.createElement("tr");

                    const claseNota = nota.nota >= 6 ? "text-success fw-bold" : "text-danger fw-bold";

                    fila.innerHTML = `
                        <td>${nota.examenMateriaNombre}</td>
                        <td>${nota.examenTipo}</td>
                        <td class="${claseNota}">${nota.nota}</td>
                    `;

                    tablaBody.appendChild(fila);
                });
            } catch (error) {
                mostrarAlerta(error.message, "danger");
                tablaBody.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center text-danger">Error al cargar las notas.</td>
                    </tr>
                `;
            }

            function mostrarAlerta(mensaje, tipo) {
                alertContainer.innerHTML = `
                    <div class="alert alert-${tipo} text-center" role="alert">
                        ${mensaje}
                    </div>
                `;
            }
        });
    </script>
}
