@{
    ViewData["Title"] = "Historia Académica";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white text-center py-3">
            <h3 class="mb-0">Historia Académica del Alumno</h3>
        </div>

        <div class="card-body">
            <div id="alert-container"></div>

            <div class="table-responsive">
                <table id="tablaNotas" class="table table-hover align-middle">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 40%;">Materia</th>
                            <th style="width: 40%;">Tipo de Examen</th>
                            <th style="width: 20%;">Nota</th>
                        </tr>
                    </thead>
                    <tbody id="tablaNotasBody">
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                Cargando notas...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const tablaBody = document.getElementById("tablaNotasBody");
            const alertContainer = document.getElementById("alert-container");

            try {
                const response = await fetch(`/Nota/ObtenerNotasPorAlumno`);
                if (!response.ok) throw new Error("Error al obtener las notas del alumno.");

                const notas = await response.json();
                tablaBody.innerHTML = "";

                if (notas.length === 0) {
                    mostrarAlerta("No se encontraron notas registradas para este alumno.", "info");
                    return;
                }

                // Agrupar por materia
                const materiasAgrupadas = {};
                notas.forEach(nota => {
                    if (!materiasAgrupadas[nota.examenMateriaNombre]) {
                        materiasAgrupadas[nota.examenMateriaNombre] = [];
                    }
                    materiasAgrupadas[nota.examenMateriaNombre].push(nota);
                });

                // Renderizar
                for (const materia in materiasAgrupadas) {
                    // Fila de título elegante
                    const filaMateria = document.createElement("tr");
                    filaMateria.innerHTML = `
                        <td colspan="3" class="fw-bold bg-light border-top ps-3">${materia}</td>
                    `;
                    tablaBody.appendChild(filaMateria);

                    // Fila de cada examen
                    materiasAgrupadas[materia].forEach(nota => {
                        const filaNota = document.createElement("tr");
                        const claseNota = nota.nota >= 6 ? "text-success fw-bold" : "text-danger fw-bold";

                        filaNota.innerHTML = `
                            <td></td>
                            <td class="text-center">${nota.examenTipo}</td>
                            <td class="text-center ${claseNota}">${nota.nota}</td>
                        `;
                        tablaBody.appendChild(filaNota);
                    });
                }
            } catch (error) {
                mostrarAlerta(error.message, "danger");
                tablaBody.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center text-danger">Error al cargar las notas.</td>
                    </tr>
                `;
            }

            function mostrarAlerta(mensaje, tipo) {
                alertContainer.innerHTML = `
                    <div class="alert alert-${tipo} text-center" role="alert">
                        ${mensaje}
                    </div>
                `;
            }
        });
    </script>
}
