
@{
	ViewData["Title"] = "Calendario Académico";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vista con Imagen</title>
    <style>
        body {
            margin: 0;
            display: flex;
            justify-content: center; /* Centra horizontalmente */
            align-items: center; /* Centra verticalmente */
            height: 100vh; /* Ocupa toda la altura de la pantalla */
            background-color: #f5f5f5; /* Opcional, solo para ver contraste */
        }

        img {
            width: 1200px; height: 800px; object-fit: fill;
        }
    </style>
</head>
<body>
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow-lg" style="max-width: 800px;">
            <div class="card-body text-center">
                <img src="~/images/CalendarioAcademico.png" class="img-fluid rounded" alt="Calendario Académico">
            </div>
        </div>
    </div>
</body>
