@model IEnumerable<Front.Models.Respuestas.MateriaFront>

@{
    ViewData["Title"] = "Materias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="max-width: 300px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="searchInput" class="form-control" placeholder="Buscar...">
        <div class="dropdown ms-2">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="btnFiltro" data-bs-toggle="dropdown" aria-expanded="false" style="height:38px; padding:2px 10px;">
                <i class="bi bi-funnel"></i> Filtro
            </button>
            <ul class="dropdown-menu p-3" aria-labelledby="btnFiltro" style="min-width: 220px;">
                <li>
                    <label>Filtrar por modalidad:</label>
                    <select id="filtroModalidad" class="form-select mb-2">
                        <option value="">Todas</option>
                        @foreach (var modalidad in Model.Select(m => m.Modalidad).Distinct())
                        {
                            <option value="@modalidad">@modalidad</option>
                        }
                    </select>
                </li>
                <li>
                    <label>Ordenar por nombre:</label>
                    <select id="ordenNombre" class="form-select">
                        <option value="">Sin orden</option>
                        <option value="asc">Ascendente (A-Z)</option>
                        <option value="desc">Descendente (Z-A)</option>
                    </select>
                </li>
            </ul>
        </div>
    </div>
    <div>
        <a href="@Url.Action("PutMateria", "Materia")" class="btn btn-secondary">Modificar</a>
        <a href="@Url.Action("CreateMateria", "Materia")" class="btn btn-secondary">Crear</a>
    </div>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-secondary">
        <tr>
            <th class="text-center">Materia</th>
            <th class="text-center">Año</th>
            <th class="text-center">Modalidad</th>
            <th class="text-center" style="width:100px;">Acciones</th>
        </tr>
    </thead>
    <tbody id="materiaTable">
        @foreach (var materia in Model)
        {
            <tr>
                <td>@materia.Nombre</td>
                <td>@materia.Anio</td>
                <td>@materia.Modalidad</td>
                <td class="text-center acciones">
                    <button type="button" class="btn btn-sm btn-info" onclick="infoMateria('@materia.Nombre')">
                        <i class="bi bi-info-circle"></i>
                    </button>

                    <button class="btn btn-sm btn-danger" onclick="deleteMateria('@materia.Nombre')">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="materiaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNombre"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Horarios:</strong> <span id="modalHorarios"></span></p>
                <p><strong>Profesor/es:</strong> <span id="modalProfesores"></span></p>
                <p><strong>Año:</strong> <span id="modalAnio"></span></p>
                <p><strong>Modalidad:</strong> <span id="modalModalidad"></span></p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro que quieres eliminar la materia <strong id="deleteMateriaNombre"></strong>?</p>

                <!-- Checkbox de confirmación -->
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="confirmDeleteCheck">
                    <label class="form-check-label" for="confirmDeleteCheck">
                        Confirmar
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnConfirmDelete" class="btn btn-danger" disabled>Eliminar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="messageModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>


<script src="/js/materias.js"></script>