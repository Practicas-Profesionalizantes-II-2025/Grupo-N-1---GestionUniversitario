@model IEnumerable<Front.Models.Respuestas.InscripcionMateriaFront>

@{
    ViewData["Title"] = "GetInscripcionesDNI";
}

<!-- Buscador y Filtro -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="max-width: 300px;">
        <!-- Ícono lupa -->
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="searchBox" class="form-control me-2" placeholder="Buscar...">

        <div class="dropdown me-2">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="btnFiltro" data-bs-toggle="dropdown" aria-expanded="false" style="height:38px; padding:2px 10px;">
                <i class="bi bi-funnel"></i> Filtro
            </button>
            <ul class="dropdown-menu p-3" aria-labelledby="btnFiltro" style="min-width: 200px;">
                <li>
                    <label>Filtrar por modalidad:</label>
                    <select id="filtroModalidad" class="form-select mb-2">
                        <option value="">Todas</option>
                        @foreach (var modalidad in Model.Select(u => u.Modalidad).Distinct())
                        {
                            <option value="@modalidad">@modalidad</option>
                        }
                    </select>
                </li>
                <li>
                    <label>Ordenar por nombre:</label>
                    <select id="ordenNombre" class="form-select">
                        <option value="">Sin orden</option>
                        <option value="asc">Ascendente</option>
                        <option value="desc">Descendente</option>
                    </select>
                </li>
            </ul>
        </div>
    </div>
</div>

<!--  Materias para Inscribirse -->
<div class="accordion" id="accordionMaterias">
    @for (int i = 0; i < Model.Count(); i++)
    {
        Front.Models.Respuestas.InscripcionMateriaFront? materia = Model.ElementAt(i);
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-@i">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i" aria-expanded="false" aria-controls="collapse-@i">
                    @materia.Nombre
                </button>
            </h2>
            <div id="collapse-@i" class="accordion-collapse collapse" aria-labelledby="heading-@i" data-bs-parent="#accordionMaterias">
                <div class="accordion-body">
                    <p><strong>Año:</strong> @materia.Anio</p>
                    <p><strong>Modalidad:</strong> @materia.Modalidad</p>
                    <p><strong>Profesores:</strong> @string.Join(", ", materia.NombresProfesores)</p>
                    <p><strong>Días y Horarios:</strong> @string.Join(", ", materia.DescripcionDiasHorarios)</p>

                    @if (materia.EstaInscripto)
                    {
                        <button class="btn btn-secondary" disabled>Inscripto</button>
                    }
                    else
                    {
                        <form asp-action="CreateInscripcion" method="post">
                            <input type="hidden" name="nombreMateria" value="@materia.Nombre" />
                            <button type="submit" class="btn btn-secondary">Inscribirse</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<script src="~/js/inscripciones.js"></script>