@model IEnumerable<Front.Models.Respuestas.InscripcionFront>

@{
    ViewData["Title"] = "GetInscripcionesAsistencia";

    // Convertimos ViewBag a tipo fuerte
    List<Front.Models.Respuestas.MateriaFront> materias = ViewBag.Materias as List<Front.Models.Respuestas.MateriaFront>;

    // Buscamos la materia seleccionada de forma segura
    Front.Models.Respuestas.MateriaFront materiaSeleccionada = null;
    if (materias != null && ViewBag.SelectedMateria != null)
    {
        materiaSeleccionada = materias.FirstOrDefault(m => m.Nombre == (string)ViewBag.SelectedMateria);
    }

    // Extraemos solo los días (la primera palabra de cada string)
    List<string> diasMateria = new List<string>();
    if (materiaSeleccionada != null && materiaSeleccionada.DescripcionDiasHorarios != null)
    {
        diasMateria = materiaSeleccionada.DescripcionDiasHorarios
                                    .Select(d => d.Split(' ')[0])
                                    .ToList();
    }
}

<div class="container">
    <h3>Cargar Asistencias</h3>

    <div class="d-flex align-items-center mb-3">
        <!-- Fecha -->
        <div class="me-3">
            <input type="date"
                   class="form-control"
                   id="fechaAsistencia"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        
        <!-- lista materias-->
        <form asp-action="GetInscripcionesAsistencia" method="get">
            <select name="nombreMateria" id="materia" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
                <option value="">Seleccione una Materia</option>
                @foreach (var materia in ViewBag.Materias)
                {
                    <option value="@materia.Nombre"
                            selected="@(ViewBag.SelectedMateria == materia.Nombre ? "selected" : null)">
                        @materia.Nombre
                    </option>
                }
            </select>
        </form>
    </div>

    <!-- Contenedor de alumnos -->
    <div class="mb-3">
        <h5>Alumnos</h5>
        <div id="alumnosContainer" class="d-flex flex-wrap">
            @foreach (var insc in Model)
            {
                <div class="alumno-card border rounded p-2 m-1">
                    <label>
                        @insc.NombreAlumno @insc.ApellidoAlumno
                        <input type="checkbox" class="asistencia" name="asistencias" value="@insc.ID" checked />
                    </label>
                </div>
            }
        </div>
    </div>

    <!-- Botones -->
    <div class="mb-3 d-flex justify-content-end">

        <button type="button"
                id="btnAbrirModal"
                class="btn btn-secondary me-2"
                data-bs-toggle="modal"
                data-bs-target="#confirmarAsistenciasModal">
                Aceptar
        </button>

        <button id="btnCancelar" type="button" class="btn btn-secondary">Cancelar</button>
    </div>
</div>

<!-- MODAL ACEPTAR -->
<form id="confirmForm" asp-action="CreateAsistencia" asp-controller="Asistencia" method="post">
    @Html.AntiForgeryToken()

    <div class="modal fade" id="confirmarAsistenciasModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Asistencias</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <p id="confirmMessage">¿Desea confirmar las asistencias?</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmCheckbox">
                        <label class="form-check-label" for="confirmCheckbox">
                            Confirmar
                        </label>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="submit" class="btn btn-secondary" id="btnAceptarFinal" disabled>Aceptar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>

            </div>
        </div>
    </div>
</form>

<script src="~/js/asistencias.js"></script>

<script>
    // Pasamos los días permitidos desde Razor a JS
    const diasPermitidos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(diasMateria));

    const fechaInput = document.getElementById("fechaAsistencia");

    // Función para validar si la fecha corresponde a un día permitido
    function esDiaPermitido(fecha) {
        const diasSemana = ["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];
        const diaNombre = diasSemana[fecha.getDay()];
        return diasPermitidos.includes(diaNombre);
    }

    // Validar al cambiar la fecha
    fechaInput.addEventListener("input", function() {
        const fechaSeleccionada = new Date(this.value);
        if (!esDiaPermitido(fechaSeleccionada)) {
            alert("La fecha seleccionada no corresponde a un día en que se dicta esta materia.");
            this.value = ""; // limpiar input
        }
    });

    // Inicializamos con hoy si es día válido
    const hoy = new Date();
    if (esDiaPermitido(hoy)) {
        fechaInput.valueAsDate = hoy;
    } else {
        fechaInput.value = "";
    }
</script>